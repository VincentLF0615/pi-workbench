{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Workbench",
  "version": "0.1.3",
  "identifier": "com.luofeng.piworkbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pi Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": [
      "icons/pi-workbench-iso-v3.ico",
      "branding-notice.txt",
      "vendor-pi/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "LuoFeng",
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Desktop workbench for the pi coding agent",
    "longDescription": "Pi Workbench drives the pi coding agent through its RPC mode, giving it a desktop UI: streaming conversations, tool cards, session trees, a command palette, and a code panel with file tree, git changes and preview.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    }
  }
}
